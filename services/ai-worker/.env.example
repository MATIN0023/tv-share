# Required for OpenAI Whisper API
OPENAI_API_KEY=

# openai | local (requires: pip install faster-whisper)
WHISPER_BACKEND=openai

# Local model size when WHISPER_BACKEND=local: tiny, base, small, medium, large-v3
WHISPER_LOCAL_MODEL=base

# Server
HOST=0.0.0.0
PORT=8100

# Limits
MAX_UPLOAD_MB=500
JOB_TTL_HOURS=24

# Paths
TEMP_DIR=./data/temp
OUTPUT_DIR=./data/output

# FFmpeg binary (must be on PATH or set full path)
FFMPEG_PATH=ffmpeg

# Optional API key to protect this service
API_KEY=

# Default transcription language (ISO 639-1, e.g. fa, en). Empty = auto-detect
WHISPER_LANGUAGE=fa
