# Required in production
JWT_SECRET=change-me-to-a-long-random-string

# Required for payment gateway callbacks (HMAC-SHA256 in X-Payment-Signature header)
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret

# Server
SERVER_ADDR=:8090
MONGO_URI=mongodb://localhost:27017
MONGO_DB=watchparty
CORS_ORIGIN=http://localhost:3000,http://localhost:8001

# Google OAuth (optional — see docs/GOOGLE_OAUTH.md)
# Same value as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Assistant microservice
ASSISTANT_SERVICE_URL=http://localhost:8200
AI_WORKER_URL=http://localhost:8100

# Redis (optional in dev — required in production)
REDIS_URL=redis://localhost:6379/0

# Development only — never set DEV_MODE=true in production
DEV_MODE=true
DEV_SEED_USERS=true
DEV_ADMIN_PHONE=09123456789
DEV_ADMIN_PASSWORD=choose-a-strong-dev-password
DEV_TEST_USER_PHONE=09121111111
DEV_TEST_USER_PASSWORD=choose-a-strong-dev-password
