# Copy to deploy/.env before: docker compose -f deploy/docker-compose.yml up -d

# ── Core ──────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string
PAYMENT_WEBHOOK_SECRET=
CORS_ORIGIN=http://localhost:3000
DEV_MODE=true

# ── Frontend (also set in frontend/.env.local) ────────
NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_WS_URL=ws://localhost:8090/ws

# ── Google OAuth ────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (optional — mock mode works without keys) ──────
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Redis (auto-wired in compose) ─────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Third-party video / CDN (future HLS worker) ───────
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# CDN_BASE_URL=https://cdn.example.com
# VIDEO_UPLOAD_WEBHOOK_SECRET=

# ── Voice (LiveKit — enable when ready) ───────────────
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
